# ===== Biến môi trường (đặt trên Vercel: Project → Settings → Environment Variables) =====

# Khóa Gemini (tùy chọn – không có thì dùng kho lời chúc mẫu). KHÔNG đặt tiền tố VITE_.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# Mật khẩu trang quản trị (BẮT BUỘC, đặt chuỗi dài, khó đoán)
ADMIN_PASSWORD=""
# Khóa ký phiên admin (tùy chọn; mặc định dùng ADMIN_PASSWORD)
# ADMIN_SECRET=""

# Service account của dự án Firebase (BẮT BUỘC): dán nguyên nội dung file JSON, trên 1 dòng
FIREBASE_SERVICE_ACCOUNT=""

# Tùy chọn
# WIN_RATE="0.3"            # xác suất trúng giải tiền mỗi lượt (0–1)
# MAX_SPINS_PER_USER="3"    # số lượt quay tối đa / tài khoản / dịp lễ
# FIRESTORE_DATABASE_ID=""  # bỏ trống = database "(default)"
