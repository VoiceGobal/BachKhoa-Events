GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Backend-only: store the service-account JSON in Vercel Environment Variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative if Vercel rejects multiline JSON: use all three fields below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional comma-separated admin emails (existing school admins are built in).
FIREBASE_ADMIN_EMAILS=
VITE_FIREBASE_ADMIN_EMAILS=
