# Gemini (chỉ dùng ở server)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Tên model Gemini (tùy chọn, mặc định gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# BẮT BUỘC: mật khẩu quản trị (>= 8 ký tự). Nếu trống, đăng nhập admin bị tắt.
ADMIN_PASSWORD=""

# Thư mục lưu dữ liệu vé/giải thưởng (nên trỏ tới ổ đĩa bền vững khi deploy)
DATA_DIR="data"

APP_URL="MY_APP_URL"
