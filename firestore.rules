rules_version = '2';

// Quy tắc: client chỉ ĐỌC dữ liệu của chính mình. Mọi thao tác ghi sự kiện (vé, giải, ngân sách,
// nhận thưởng, lịch sử quay) do máy chủ (Vercel Function + Firebase Admin SDK) thực hiện –
// Admin SDK bỏ qua rules. Các collection ev_* không có rule nào nên client bị chặn hoàn toàn.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin phải dùng email ĐÃ XÁC MINH (chặn việc đăng ký bằng email admin mà chưa xác minh)
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['tuancuong241298@gmail.com', 'cuongtt.ptit@gmail.com'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'spinsRemaining', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'spinsRemaining', 'totalSpins', 'createdAt', 'lastSpinAt']) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.spinsRemaining is int && data.spinsRemaining >= 0 && data.spinsRemaining <= 3 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('totalSpins' in data) || (data.totalSpins is int && data.totalSpins >= 0)) &&
             (!('lastSpinAt' in data) || (data.lastSpinAt is string && data.lastSpinAt.size() <= 50));
    }

    // 1. Hồ sơ người dùng (chỉ để hiển thị số lượt; số lượt thật do server kiểm soát)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == userId && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUserProfile(incoming()) &&
         incoming().uid == existing().uid &&
         incoming().createdAt == existing().createdAt &&
         incoming().spinsRemaining <= existing().spinsRemaining &&
         incoming().diff(existing()).affectedKeys().hasOnly(['spinsRemaining', 'totalSpins', 'lastSpinAt', 'displayName'])) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // 2. Lịch sử quay – chỉ server ghi
    match /spins/{spinId} {
      allow get: if isValidId(spinId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 3. Lịch sử nhận thưởng – chỉ server ghi
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 4. Danh sách admin (tùy chọn)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Mọi collection khác (ev_config, ev_tickets, ev_claims, ev_players, ev_logs…) bị chặn với client
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
