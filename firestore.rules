rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email in [
          'tuancuongnx@gmail.com',
          'tuancuong241298@gmail.com',
          'cuongtt.ptit@gmail.com',
          'admin@bachkhoa.edu.vn',
          'bksamsong@bachkhoa.edu.vn'
        ])
      );
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'spinsRemaining', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'spinsRemaining', 'totalSpins', 'createdAt', 'lastSpinAt']) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.spinsRemaining is int && data.spinsRemaining >= 0 && data.spinsRemaining <= 3 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('totalSpins' in data) || (data.totalSpins is int && data.totalSpins >= 0)) &&
             (!('lastSpinAt' in data) || (data.lastSpinAt is string && data.lastSpinAt.size() <= 50));
    }

    function isValidSpinRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'segmentIndex', 'label', 'wishMessage', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'userEmail', 'segmentIndex', 'label', 'wishMessage', 'prizeAmount', 'isCashPrize', 'claimCode', 'claimed', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.segmentIndex is int && data.segmentIndex >= 0 && data.segmentIndex <= 20 &&
             data.label is string && data.label.size() <= 100 &&
             data.wishMessage is string && data.wishMessage.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
             (!('prizeAmount' in data) || (data.prizeAmount is int && data.prizeAmount >= 0)) &&
             (!('isCashPrize' in data) || data.isCashPrize is bool) &&
             (!('claimCode' in data) || (data.claimCode is string && data.claimCode.size() <= 50)) &&
             (!('claimed' in data) || data.claimed is bool);
    }

    function isValidClaimRecord(data) {
      return data.keys().hasAll(['id', 'claimCode', 'userId', 'fullName', 'momoPhone', 'amount', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'claimCode', 'ticketCode', 'userId', 'userEmail', 'fullName', 'momoPhone', 'department', 'schoolClassOrDepartment', 'amount', 'payoutMethod', 'note', 'guardianNote', 'status', 'adminNote', 'transactionRef', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.claimCode is string && data.claimCode.size() <= 50 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.momoPhone is string && data.momoPhone.size() >= 9 && data.momoPhone.size() <= 15 &&
             data.amount is int && data.amount >= 0 && data.amount <= 1000000 &&
             data.status in ['pending', 'verified', 'transferred', 'rejected'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 150)) &&
             (!('schoolClassOrDepartment' in data) || (data.schoolClassOrDepartment is string && data.schoolClassOrDepartment.size() <= 150)) &&
             (!('ticketCode' in data) || (data.ticketCode is string && data.ticketCode.size() <= 50)) &&
             (!('payoutMethod' in data) || (data.payoutMethod is string && data.payoutMethod.size() <= 30)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('guardianNote' in data) || (data.guardianNote is string && data.guardianNote.size() <= 500)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
             (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == userId && isValidUserProfile(incoming()) && incoming().spinsRemaining == 3;
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUserProfile(incoming()) &&
         incoming().uid == existing().uid &&
         incoming().createdAt == existing().createdAt &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // 2. Spins collection
    match /spins/{spinId} {
      allow get: if isValidId(spinId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 3. Claims collection
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 4. Admins lookup
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. Event Configuration & Prize Tiers (MoMo Admin & LuckyWheel)
    match /event_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /prize_tiers/{tierId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 6. Tickets
    match /tickets/{ticketCode} {
      allow read, create, update, delete: if false;
    }

    // 7. Audit Logs
    match /audit_logs/{logId} {
      allow read, create, update, delete: if false;
    }
  }
}

