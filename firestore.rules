rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict Admin verification - No guest accounts permitted
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email in [
          'tuancuong241298@gmail.com',
          'cuongtt.ptit@gmail.com',
          'admin@bachkhoa.edu.vn',
          'bksamsong@bachkhoa.edu.vn'
        ])
      );
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'spinsRemaining', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'spinsRemaining', 'totalSpins', 'createdAt', 'lastSpinAt']) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.spinsRemaining is int && data.spinsRemaining >= 0 && data.spinsRemaining <= 3 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('totalSpins' in data) || (data.totalSpins is int && data.totalSpins >= 0)) &&
             (!('lastSpinAt' in data) || (data.lastSpinAt is string && data.lastSpinAt.size() <= 50));
    }

    function isValidSpinRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'segmentIndex', 'label', 'wishMessage', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'userEmail', 'segmentIndex', 'label', 'wishMessage', 'prizeAmount', 'isCashPrize', 'claimCode', 'claimed', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.segmentIndex is int && data.segmentIndex >= 0 && data.segmentIndex <= 20 &&
             data.label is string && data.label.size() <= 100 &&
             data.wishMessage is string && data.wishMessage.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
             (!('prizeAmount' in data) || (data.prizeAmount is int && data.prizeAmount >= 0)) &&
             (!('isCashPrize' in data) || data.isCashPrize is bool) &&
             (!('claimCode' in data) || (data.claimCode is string && data.claimCode.size() <= 50)) &&
             (!('claimed' in data) || data.claimed is bool);
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == userId && isValidUserProfile(incoming()) && incoming().spinsRemaining == 3;
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUserProfile(incoming()) &&
         incoming().uid == existing().uid &&
         incoming().createdAt == existing().createdAt &&
         incoming().spinsRemaining <= existing().spinsRemaining &&
         (!('totalSpins' in incoming()) || !('totalSpins' in existing()) || incoming().totalSpins >= existing().totalSpins) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['spinsRemaining', 'totalSpins', 'lastSpinAt', 'displayName'])) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // 2. Spins collection (Audited read & log)
    match /spins/{spinId} {
      allow get: if isValidId(spinId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(spinId) && isSignedIn() && incoming().id == spinId && incoming().userId == request.auth.uid && isValidSpinRecord(incoming());
      allow update: if isValidId(spinId) && isSignedIn() && resource.data.userId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['claimed']);
      allow delete: if false;
    }

    // 3. Claims collection (STRICT SECURITY)
    // Client is completely FORBIDDEN from creating money claims directly.
    // Claims can only be instantiated through backend transactional spin engine.
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false; // Zero client creations permitted!
      allow update: if isValidId(claimId) && (
        (isSignedIn() && isOwner(existing().userId) && existing().status == 'pending' &&
         incoming().id == existing().id && incoming().userId == existing().userId &&
         incoming().amount == existing().amount &&
         incoming().claimCode == existing().claimCode &&
         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'momoPhone', 'department', 'schoolClassOrDepartment', 'note', 'guardianNote', 'updatedAt'])) ||
        (isAdmin() && incoming().amount == existing().amount)
      );
      allow delete: if isAdmin();
    }

    // 4. Admins lookup
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. Event Configuration & Prize Tiers (Admin Only Writes)
    match /event_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prize_tiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Tickets (Read-only for public, modifications strictly by Admin/Backend)
    match /tickets/{ticketCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
